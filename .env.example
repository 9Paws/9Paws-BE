# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
DEV_PORT=8080
SPRING_PROFILES_ACTIVE=dev
BACKEND_IP=127.0.0.1

# ==============================================================================
# DATABASE (POSTGRESQL)
# ==============================================================================
POSTGRES_DB=ninepaws_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password
REDIS_EXTERNAL_PORT=6379

# ==============================================================================
# EMAIL (SMTP - GMAIL APP PASSWORD / TRANSACTIONAL EMAIL)
# ==============================================================================
# Máy chủ SMTP: smtp.gmail.com (hoặc smtp.mailtrap.io nếu test giả lập)
MAIL_HOST=smtp.gmail.com
# Port SMTP: 587 (STARTTLS) hoặc 465 (SSL)
MAIL_PORT=587
# Tài khoản email gửi (ví dụ: your_name@gmail.com)
EMAIL_USERNAME=your_email@gmail.com
# Mật khẩu ứng dụng 16 ký tự của Google (Tạo tại: myaccount.google.com -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng)
EMAIL_PASSWORD=your_16_digit_app_password

# ==============================================================================
# API DOCUMENTATION (SCALAR & OPENAPI)
# ==============================================================================
SCALAR_PATH=/docs
SCALAR_URL=/v3/api-docs
SCALAR_ENABLED=true

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET=TmluZVBhd3NTdXBlclNlY3JldFNpZ25pbmdLZXlGb3JKd3RUb2tlbnNITUFDU0hBMjU2QXRMZWFzdDI1NkJpdHNMb25nMjAyNiE=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
GOOGLE_CLIENT_ID=your_google_web_client_id_here

# ==============================================================================
# OTP & RATE LIMITING
# ==============================================================================
OTP_LENGTH=6
OTP_TTL_MINUTES=5
MAX_ATTEMPTS=3
RESEND_COOLDOWN_SECONDS=60
RESET_MAX_PER_HOUR=5

# ==============================================================================
# SPRING AI (GOOGLE GEN AI) - TRỢ LÝ MIU MIU
# ==============================================================================
SPRING_AI_GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# EXTERNAL SERVICES (CLOUDINARY & FIREBASE)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

FIREBASE_CONFIG_PATH=classpath:firebase/firebase-adminsdk.json


GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
