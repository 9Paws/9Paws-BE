# ==============================================================================
# 9PAWS BACKEND - PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# Copy this file to /opt/ninepaws/.env on the production VPS and fill in values.
# Permissions on VPS: chmod 600 /opt/ninepaws/.env

# --- Application Core ---
SPRING_PROFILES_ACTIVE=prod
PORT=8080
BACKEND_IP=127.0.0.1
CORS_ALLOWED_ORIGIN_PATTERNS=https://ninepaws.com,https://api.ninepaws.com

# --- PostgreSQL Configuration ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ninepaws_db
POSTGRES_USER=ninepaws_admin
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# --- JWT Security ---
# Secret must be at least 256-bit (32 bytes) hex or Base64 string
JWT_SECRET=replace_with_a_secure_random_base64_or_hex_key_at_least_32_characters
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- OTP Policy ---
OTP_LENGTH=6
OTP_TTL_MINUTES=5
MAX_ATTEMPTS=3
RESEND_COOLDOWN_SECONDS=60
RESET_MAX_PER_HOUR=3

# --- Mail / SMTP Configuration ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
EMAIL_USERNAME=replace_with_smtp_username@gmail.com
EMAIL_PASSWORD=replace_with_smtp_app_password

# --- Cloudinary (Media Storage) ---
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# --- Spring AI & Google Gemini ---
SPRING_AI_GOOGLE_GENAI_API_KEY=replace_with_google_gemini_api_key
